# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GST_API_KEY (Optional): Official GSTN / GSP lookup key (e.g. gstincheck) for direct MCA/GSTIN taxpayer verification.
# Configure securely via Secrets if you have a commercial GST verification API key.
GST_API_KEY=""

# GEMINI_MODEL (Optional): Override primary Gemini model ID on external hosts (e.g. "gemini-2.5-flash" on Render.com).
# Leave empty in AI Studio to use the default active model order automatically.
GEMINI_MODEL=""

# ---------------------------------------------------------------------------
# Ed25519 Asymmetric Software Licensing (Private Key stays strictly on server/offline)
# Generate a keypair with: npx tsx scripts/admin-license-keygen.ts keygen
# ---------------------------------------------------------------------------
# LICENSE_PRIVATE_KEY: Base64 32-byte Ed25519 seed (or PKCS8 PEM) used ONLY by server /api/license/issue or offline CLI.
# NEVER prefix with VITE_ or commit a real private key to source control.
LICENSE_PRIVATE_KEY=""

# VITE_LICENSE_PUBLIC_KEY: Base64 32-byte Ed25519 Public Key embedded in browser & Electron builds for signature verification.
VITE_LICENSE_PUBLIC_KEY="k9ux0kyzL0C1lOC7QkRHxkY2ILtxX8j0FDb9NL4/VWs="

# OWNER_ADMIN_EMAIL: Verified Firebase account email authorized to call POST /api/license/issue.
OWNER_ADMIN_EMAIL="shailendrabanwar@gmail.com"

# VITE_API_BASE_URL: External Render backend URL when frontend is hosted on Firebase Hosting (e.g. https://api.hisabveda.com).
# Leave empty when serving frontend + backend from the same Node server.
VITE_API_BASE_URL=""

# VITE_LICENSE_SERVER_URL: Optional custom endpoint override for customer "Request License Certificate on Email" form.
VITE_LICENSE_SERVER_URL=""

# VITE_WINDOWS_INSTALLER_URL: Direct HTTPS or GitHub Release URL for the Windows Desktop (.exe) installer.
VITE_WINDOWS_INSTALLER_URL="https://github.com/shailendrabanwar-bot/hisabveda-erp/releases/latest/download/HisabVeda-Setup.exe"

# Auto-License Mailer Server Vars (used ONLY in Render/Server env vars; never commit secrets or expose in client)
PRIVATE_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HisabVeda Support <support@hisabveda.com>"
SUPPORT_EMAIL="support@hisabveda.com"
ADMIN_EMAIL=""
ALLOWED_ORIGIN="https://hisabveda.com,https://www.hisabveda.com,https://hisabveda.in,app://hisabveda"

