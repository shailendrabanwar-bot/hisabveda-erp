@echo off
TITLE HisabVeda ERP Software - Windows EXE Build Package
color 0A

:: Set working directory to project root folder
cd /d "%~dp0"
if exist "..\package.json" cd ..

echo =========================================================================
echo              HISABVEDA ERP SOFTWARE v2.0 - WINDOWS SETUP
echo =========================================================================
echo.

:: Check package.json exists in the current working directory
if not exist "package.json" (
    echo [ERROR] package.json was not found in: %CD%
    echo Please extract all files from the downloaded ZIP archive and run this script from inside the unzipped folder.
    echo.
    pause
    exit /b 1
)

echo  [1/5] Checking Node.js & npm Environment...
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] Node.js is not installed on this Windows PC.
    echo Please download and install Node.js LTS (v20+) from https://nodejs.org/
    echo.
    pause
    exit /b 1
)
where npm >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] npm was not found on PATH. Please reinstall Node.js LTS.
    echo.
    pause
    exit /b 1
)

echo  [+] Node.js detected:
node -v
echo  [+] npm detected:
call npm -v

echo.
echo  [2/5] Verifying Electron Process & Official App Icon Assets...
if not exist "electron\main.js" (
    echo [ERROR] Missing required file: electron\main.js
    pause
    exit /b 1
)
if not exist "electron\preload.js" (
    echo [ERROR] Missing required file: electron\preload.js
    pause
    exit /b 1
)
if not exist "public\hv-icon.ico" (
    if exist "public\icon.ico" (
        copy /Y "public\icon.ico" "public\hv-icon.ico" >nul
    ) else if exist "%~dp0HisabVeda.ico" (
        copy /Y "%~dp0HisabVeda.ico" "public\hv-icon.ico" >nul
    ) else (
        echo [ERROR] Missing app icon: public\hv-icon.ico
        pause
        exit /b 1
    )
)
echo  [+] Verified electron\main.js, electron\preload.js, and public\hv-icon.ico

echo.
echo  [3/5] Installing Application & Electron Build Dependencies...
call npm install
if %errorlevel% neq 0 (
    echo [ERROR] npm install failed. Check internet connection and retry.
    pause
    exit /b 1
)
if not exist "node_modules\electron" (
    call npm install --save-dev electron electron-builder
    if %errorlevel% neq 0 (
        echo [ERROR] Failed to install electron / electron-builder.
        pause
        exit /b 1
    )
) else if not exist "node_modules\electron-builder" (
    call npm install --save-dev electron-builder
    if %errorlevel% neq 0 (
        echo [ERROR] Failed to install electron-builder.
        pause
        exit /b 1
    )
)

echo.
echo  [4/5] Building Vite Production Bundle & Server Bundle...
set VITE_ELECTRON_BUILD=true
call npm run build
if %errorlevel% neq 0 (
    echo [ERROR] Vite production build failed! Fix build errors above and retry.
    pause
    exit /b 1
)
if not exist "dist\index.html" (
    echo [ERROR] Expected dist\index.html was not generated by Vite build.
    pause
    exit /b 1
)

echo.
echo  [5/6] Hardening & Obfuscating Production Bundles (ASAR + Obfuscator)...
call node scripts\obfuscate-build.mjs
if %errorlevel% neq 0 (
    echo [ERROR] Bundle obfuscation failed!
    pause
    exit /b 1
)

echo.
echo  [6/6] Compiling HisabVeda ERP Windows Installer (.exe)...
call npx electron-builder --win nsis portable
if %errorlevel% neq 0 (
    echo [ERROR] electron-builder failed to package the Windows .exe!
    pause
    exit /b 1
)

echo.
echo =========================================================================
echo   SUCCESS! Windows Executable setup created in dist-electron/
echo =========================================================================
echo.
if exist "dist-electron" explorer dist-electron
pause
