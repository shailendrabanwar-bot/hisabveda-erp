{
  "name": "hisabveda-erp-software",
  "productName": "HisabVeda ERP",
  "private": true,
  "version": "2.0.0",
  "main": "electron/main.js",
  "build": {
    "appId": "com.hisabveda.erp",
    "productName": "HisabVeda ERP",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/hv-icon.ico",
      "public/icon.ico",
      "public/icon.svg",
      "public/hv-app-512.png",
      "!src/**/*",
      "!scripts/**/*",
      "!scripts/admin-license-keygen*",
      "!scripts/*.bat",
      "!dev-dist/**/*",
      "!.aistudio/**/*",
      "!.env*",
      "!**/*.test.*",
      "!firestore.rules*",
      "!security_spec.md",
      "!walkthrough.md",
      "!server.ts",
      "!server/**/*",
      "!tsconfig.json",
      "!vite.config.ts",
      "!eslint.config.mjs",
      "!index.html"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "public/hv-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "obfuscate": "node scripts/obfuscate-build.mjs",
    "obfuscate:desktop": "node scripts/obfuscate-build.mjs",
    "build:exe": "vite build && node scripts/obfuscate-build.mjs && electron-builder --win",
    "electron:dev": "vite & electron .",
    "preview": "npm run build && NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "html2canvas": "^1.4.1",
    "javascript-obfuscator": "^5.10.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "tweetnacl": "^1.0.3",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
